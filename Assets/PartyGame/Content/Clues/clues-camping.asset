  m_Name: clues-camping
  m_EditorClassIdentifier: PartyGame.Runtime::PartyGame.Core.Content.CluePackData
  id: clues-camping
  displayName: The camping trip
  description: Wet, cold and somebody is lying
  glyph: CT
  accentIndex: 2
  enabled: 1
  premium: 0
  freshness: 0
  reviewBy: 
  clues:
  - id: c86
    kind: 0
    text: The last of the firewood vanished while everyone was supposedly asleep.
  - id: c87
    kind: 0
    text: One tent has been moved three metres to the left overnight.
  - id: c88
    kind: 0
    text: The only working torch has been found with the batteries removed.
  - id: c89
    kind: 0
    text: Somebody finished the marshmallows and put the empty bag back.
  - id: c90
    kind: 0
    text: There are footprints leading to the river and none leading back.
  - id: c91
    kind: 0
    text: The car keys were in a different pocket to the one they were left in.
  - id: c92
    kind: 0
    text: Somebody let the fire go out and then loudly blamed the wood.
  - id: c93
    kind: 0
    text: A tent peg has been used to open a tin and is now unusable.
  - id: c94
    kind: 1
    text: You were up in the night. Exactly one of {a} and {b} was outside their tent.
  - id: c95
    kind: 1
    text: Two head torches were on at 3am. One of {a} and {b} is involved.
  - id: c96
    kind: 1
    text: You counted boots by the fire. Exactly one of {a} and {b} had wet ones.
  - id: c97
    kind: 2
    text: You were awake by the fire, watching. {fact}
  - id: c98
    kind: 2
    text: You noticed who sided with whom around the fire. {fact}
  - id: c99
    kind: 2
    text: You have been keeping track of who goes along with what. {fact}
  - id: c100
    kind: 3
    text: Somebody found it written in the campsite log book. {fact}
  - id: c101
    kind: 3
    text: The family in the next tent mentioned one thing. {fact}
  - id: c102
    kind: 3
    text: It came out around the fire and everyone went quiet. {fact}
